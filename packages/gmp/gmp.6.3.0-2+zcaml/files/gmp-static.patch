diff -ru a/src/build.sh.in b/src/build.sh.in
--- a/src/build.sh.in	2026-11-08 02:42:49.730189933 +0530
+++ b/src/build.sh.in	2026-11-08 02:42:49.745280564 +0530
@@ -38,6 +38,8 @@
 
 chmod +x configure
 
+# Windows: GMP's gmp.h differs for a DLL, so it builds a static library or a DLL.
+case "$3" in *mingw*|*windows*|*cygwin*) set -- "$1" "$2" "$3" "$4" false "$6" "$7" ;; esac
 if [ "$5" = "false" ]; then
     SHARED_LIBRARY_ARG="--disable-shared"
 fi
@@ -48,10 +50,11 @@
 # $4 => ocamlc_cflags
 # $5 => supports_shared_libraries
 # $6 => native_c_libraries
+# $7 => ext_dll
 
 ac_cv_func_obstack_vprintf=no \
 ac_cv_func_localeconv=no \
-./configure --host="$3" --build="$2" ABI=64 CC="$1" CPPFLAGS="$4" LIBS="$6" $SHARED_LIBRARY_ARG
+./configure --host="$3" --build="$2" ABI=64 CC="$1" CPPFLAGS="$4" LIBS="$6" --with-pic $SHARED_LIBRARY_ARG
 
 make SUBDIRS="mpn mpz mpq mpf"\
     -j%{jobs}% \
@@ -70,7 +73,7 @@
       fi
     done
     # depending on if the host is macos or not
-    cp "$libgmp" ../dllgmp.so || cp .libs/libgmp.dylib ../dllgmp.so
+    cp "$libgmp" ../dllgmp$7 || cp .libs/libgmp.dylib ../dllgmp$7
 else
-    touch ../dllgmp.so
+    touch ../dllgmp$7
 fi
diff -ru a/src/dune b/src/dune
--- a/src/dune	2026-11-08 02:42:49.730189933 +0530
+++ b/src/dune	2026-11-08 02:42:49.745012658 +0530
@@ -6,13 +6,8 @@
  (install_c_headers gmp)
  (foreign_archives gmp))
 
-(install
- (files
-  (dllgmp.so as libgmp.so))
- (section lib))
-
 (rule
- (targets gmp.h libgmp.a dllgmp.so)
+ (targets gmp.h libgmp.a dllgmp%{ext_dll})
  (deps gmp-6.3.0.tar.xz build.sh gcc.15.patch)
  (action
   (with-stdout-to
@@ -20,7 +15,7 @@
    (run sh ./build.sh "%{ocaml-config:c_compiler}" "%{ocaml-config:host}"
      "%{ocaml-config:target}" "%{ocaml-config:ocamlc_cflags}"
      %{ocaml-config:supports_shared_libraries}
-     "%{ocaml-config:native_c_libraries}"))))
+     "%{ocaml-config:native_c_libraries}" %{ext_dll}))))
 
 (rule
  (target build.sh)
