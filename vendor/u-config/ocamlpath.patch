+// The search path implied by OCAMLPATH, ';'-joined: each entry itself, then
+// <entry>/<name> for every directory under it, all with a pkgconfig suffix.
+// dune pkg sets OCAMLPATH to its dependencies' lib directories, and each
+// dependency installs pkg-config files as <lib>/<package>/pkgconfig/<name>.pc.
+static s8 ocamlpath_libdir_(arena *perm, s8 ocamlpath)
+{
+    // Reserve a scratch region at the top for one entry's UTF-16 conversions,
+    // leaving the rest of the arena to grow the output at the bottom. Both
+    // are arena-backed: running out is reported as out of memory, never a
+    // silently truncated search path.
+    iz scratchcap = 4*ocamlpath.len + 4096;
+    byte *scratchbeg = new(perm, byte, scratchcap);
+    arena scratch = *perm;
+    scratch.beg = scratchbeg;
+    scratch.end = scratchbeg + scratchcap;
+
+    u8buf out = newmembuf(perm);
+    b32 first = 1;
+
+    s8 path = ocamlpath;
+    while (path.len) {
+        cut c = s8cut(path, ';');
+        s8 entry = c.head;
+        path = c.tail;
+        if (!entry.len) {
+            continue;
+        }
+
+        if (!first) {
+            printu8(&out, ';');
+        }
+        first = 0;
+        prints8(&out, entry);
+        prints8(&out, S("/pkgconfig"));
+
+        scratch.beg = scratchbeg;
+        scratch.end = scratchbeg + scratchcap;
+        u8buf g = newmembuf(&scratch);
+        prints8(&g, entry);
+        prints8(&g, S("/*\0"));
+        s8 glob = finalize(&g);
+        s16 wide = towide_(&scratch, glob);
+
+        finddata fd = {0};
+        iptr h = FindFirstFileW(wide.s, &fd);
+        if (h == -1) {
+            continue;
+        }
+        do {
+            if (!(fd.attr & FILE_ATTRIBUTE_DIRECTORY)) {
+                continue;
+            }
+            s16 name = {0};
+            name.s = fd.name;
+            for (; name.s[name.len]; name.len++) {}
+            byte *saveend = scratch.end;
+            s8 n = fromwide_(&scratch, name);
+            if (!s8equals(n, S(".")) && !s8equals(n, S(".."))) {
+                if (!first) {
+                    printu8(&out, ';');
+                }
+                first = 0;
+                prints8(&out, entry);
+                prints8(&out, S("/"));
+                prints8(&out, n);
+                prints8(&out, S("/pkgconfig"));
+            }
+            scratch.end = saveend;
+        } while (FindNextFileW(h, &fd));
+        FindClose(h);
+    }
+    return finalize(&out);
+}
