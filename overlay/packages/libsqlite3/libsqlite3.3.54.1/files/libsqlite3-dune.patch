diff -ruN a/dune b/dune
--- a/dune	1970-01-01 05:30:00.000000000 +0530
+++ b/dune	2026-11-08 05:28:31.504905543 +0530
@@ -0,0 +1,21 @@
+; SQLite's amalgamation, as a library with no modules: depending on it
+; compiles C stubs with its headers and links it.
+(library
+ (name libsqlite3)
+ (public_name libsqlite3)
+ (modules)
+ (foreign_stubs
+  (language c)
+  (names sqlite3)
+  (flags
+   :standard
+   -DSQLITE_THREADSAFE=1
+   -DSQLITE_ENABLE_FTS3
+   -DSQLITE_ENABLE_FTS3_PARENTHESIS
+   -DSQLITE_ENABLE_FTS5
+   -DSQLITE_ENABLE_RTREE
+   -DSQLITE_ENABLE_GEOPOLY
+   -DSQLITE_ENABLE_MATH_FUNCTIONS
+   -DSQLITE_ENABLE_COLUMN_METADATA
+   -DSQLITE_ENABLE_DBSTAT_VTAB))
+ (install_c_headers sqlite3 sqlite3ext))
diff -ruN a/dune-project b/dune-project
--- a/dune-project	1970-01-01 05:30:00.000000000 +0530
+++ b/dune-project	2026-11-08 05:28:31.491514310 +0530
@@ -0,0 +1,3 @@
+(lang dune 3.0)
+(name libsqlite3)
+(package (name libsqlite3) (allow_empty))
